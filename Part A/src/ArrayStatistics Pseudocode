START
  SET ServiceTimes to array of service times
  SET totalStudents to the number of elements in serviceTimes
  SET totalTime to 0
  FOR each service time in serviceTimes
     ADD service time to totalTime
  ENDFOR
  CALCULATE averageTime
     avaregeTime = totalTime / totalStudents
  SET highest to first element of serviceTimes
  FOR each remaining service time 
      IF service > highest
         SET highest to service time
      ENDIF
  ENFOR
  SET lowest to first element of serviceTimes
  FOR each remaining serviceTime 
     IF service time < lowest
        SET lowest to service time
     ENDIF
  ENDFOR
  SET longerThan10 to 0
  FOR each service time in serviceTimes
     IF service time > 10
        INCREMENT longerThan10
     ENDIF
  ENDFOR
  DISPLAY totalStudents
  DISPLAY totalTime
  DISPLAY averageTime
  DISPLAY highest
  Display lowest
  DISPLAY longerThan10
END
