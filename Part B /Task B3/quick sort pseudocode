quickSort(int[] array, int start, int end) {
    if (start >= end) {
        int pivot = start;
    int i = start;
    int j = end;

    while (i < j){
        while (i < end && array[i] <= array[pivot]) {
            i = i + 1;
        }
        while (array[j] > array[pivot]) {
            j = j - 1;
        }
        if (i < j) {
            int temp = array[i];
            array[i] = array[j];
            array[j] = temp;
        }
    }
    int temp = array[pivot];
    array[pivot] = array[j];
    array[j] = temp;

    quickSort(array, start, j - 1);
    quickSort(array, j + 1, end);
 
  }
}
