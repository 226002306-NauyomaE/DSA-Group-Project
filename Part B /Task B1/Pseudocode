Start
  selectionSort(array)
     n = LENGTH of array
     comparisons = 0
     swaps = 0

    FOR (i = 0; i < n - 1; i++) DO         
          min = i                         

        FOR (j = i + 1; j < n; j++) DO     
               comparisons = comparisons + 1   
            IF (array[j] < array[min]) THEN
                SET min = j
            ENDIF
        ENDFOR

        IF (min != i) THEN
             temp = array[i]             
             array[i] = array[min]
             array[min] = temp           
             swaps = swaps + 1           
        ENDIF
    ENDFOR
END 
